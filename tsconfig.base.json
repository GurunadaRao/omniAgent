{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@omni/database/*": ["packages/database/*"],
      "@omni/events/*": ["packages/events/*"],
      "@omni/sdk/*": ["packages/sdk/*"],
      "@omni/shared/*": ["packages/shared/*"]
    }
  }
}
